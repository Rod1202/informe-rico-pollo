# Copiar a .env y reemplazar cada 0000 por el PIN real.
# En Netlify se cargan en Site settings > Environment variables.
# Deben ser exactamente 4 dígitos; cualquier otro valor se ignora.
#
# NO poner los PINs reales en este archivo: está versionado y el escaneo de
# secretos de Netlify falla el build si encuentra aquí el valor de una variable.

# Acceso completo (todas las vistas)
VITE_PIN_GENERAL=0000
# Tablero KPI · Gerencia, sin restricción de usuarios
VITE_PIN_KPI=0000

# Gerencias: cada PIN abre solo el tablero de Gerencia y solo con el consumo
# de los usuarios que USUARIOS_GERENCIAS.xlsx asigna a esa division.
VITE_PIN_GER_COMERCIAL=0000
VITE_PIN_GER_FINANZAS=0000
VITE_PIN_GER_GESTION_HUMANA=0000
VITE_PIN_GER_MARKETING=0000
VITE_PIN_GER_TI=0000
VITE_PIN_GER_CALIDAD=0000
VITE_PIN_GER_LOGISTICA=0000
VITE_PIN_GER_PLANTA_AB=0000
VITE_PIN_GER_GENERAL=0000
VITE_PIN_GER_RETAIL=0000
VITE_PIN_GER_AVICOLA=0000
VITE_PIN_GER_PORCINA=0000
VITE_PIN_GER_AGROINDUSTRIALES=0000
VITE_PIN_GER_OFICINA_EJECUTIVA=0000
VITE_PIN_GER_LEGAL=0000
VITE_PIN_GER_CAPACIDADES=0000
