# Copiar a .env y completar. En Netlify: Site settings > Environment variables.
# Deben ser exactamente 4 dígitos; cualquier otro valor se ignora.

# Acceso completo (todas las vistas)
VITE_PIN_GENERAL=0000
# Tablero KPI · Gerencia, sin restriccion de usuarios
VITE_PIN_KPI=2026

# Gerencias: cada PIN abre solo el tablero de Gerencia y solo con el consumo
# de los usuarios que USUARIOS_GERENCIAS.xlsx asigna a esa division.
VITE_PIN_GER_COMERCIAL=1201
VITE_PIN_GER_FINANZAS=1202
VITE_PIN_GER_GESTION_HUMANA=1203
VITE_PIN_GER_MARKETING=1204
VITE_PIN_GER_TI=1205
VITE_PIN_GER_CALIDAD=1206
VITE_PIN_GER_LOGISTICA=1207
VITE_PIN_GER_PLANTA_AB=1208
VITE_PIN_GER_GENERAL=1209
VITE_PIN_GER_RETAIL=1210
VITE_PIN_GER_AVICOLA=1211
VITE_PIN_GER_PORCINA=1212
VITE_PIN_GER_AGROINDUSTRIALES=1213
VITE_PIN_GER_OFICINA_EJECUTIVA=1214
VITE_PIN_GER_LEGAL=1215
VITE_PIN_GER_CAPACIDADES=1216
